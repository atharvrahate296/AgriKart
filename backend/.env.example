PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Integration (Dashboard ➔ Settings ➔ API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Custom Nodemailer SMTP (For Password Reset / OTP Emails)
# Gmail users: generate an "App Password" at https://myaccount.google.com/apppasswords
# Other providers (SendGrid, Mailgun, etc.) just set the relevant host/port/user/pass.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="AgriKart <your-email@gmail.com>"
